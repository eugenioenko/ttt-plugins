{
  "name": "docker-manager",
  "displayName": "Docker Manager",
  "description": "Manage Docker or Podman containers, images and volumes",
  "version": "0.2.0",
  "author": "eugenioenko",
  "entry": "init.lua",
  "api": 1,
  "permissions": {
    "panel.sidebar": true,
    "commands": true,
    "keybindings": true,
    "settings": true,
    "settings_keys": ["docker.runtime"],
    "system.exec": ["docker", "podman"]
  }
}
